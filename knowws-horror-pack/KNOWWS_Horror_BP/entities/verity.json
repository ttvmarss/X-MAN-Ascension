{
  "format_version": "1.21.50",
  "minecraft:entity": {
    "description": {
      "identifier": "knws:verity",
      "is_spawnable": true,
      "is_summonable": true,
      "properties": {
        "knws:phase": {
          "type": "int",
          "range": [0, 4],
          "default": 0,
          "client_sync": true
        }
      }
    },
    "component_groups": {
      "knws:phase_nice": {
        "minecraft:movement": { "value": 0.25 },
        "minecraft:behavior.follow_owner": { "priority": 2, "speed_multiplier": 1.1, "start_distance": 6, "stop_distance": 3 }
      },
      "knws:phase_zesty": {
        "minecraft:movement": { "value": 0.3 },
        "minecraft:behavior.follow_owner": { "priority": 2, "speed_multiplier": 1.3, "start_distance": 8, "stop_distance": 2 }
      },
      "knws:phase_weird": {
        "minecraft:movement": { "value": 0.28 },
        "minecraft:behavior.follow_owner": { "priority": 2, "speed_multiplier": 1.2, "start_distance": 10, "stop_distance": 2 }
      },
      "knws:phase_scary": {
        "minecraft:movement": { "value": 0.32 },
        "minecraft:behavior.follow_owner": { "priority": 2, "speed_multiplier": 1.4, "start_distance": 12, "stop_distance": 1 }
      },
      "knws:floating": {
        "minecraft:can_fly": {},
        "minecraft:navigation.float": { "can_float": true },
        "minecraft:movement.generic": {},
        "minecraft:physics": { "has_gravity": false }
      }
    },
    "components": {
      "minecraft:type_family": { "family": ["knws_verity", "verity", "mob"] },
      "minecraft:health": { "value": 999, "max": 999 },
      "minecraft:collision_box": { "width": 0.6, "height": 0.6 },
      "minecraft:nameable": {},
      "minecraft:damage_sensor": {
        "triggers": [{ "cause": "all", "deals_damage": false }]
      },
      "minecraft:behavior.float": { "priority": 0 },
      "minecraft:behavior.look_at_player": { "priority": 4, "look_distance": 12 },
      "minecraft:behavior.random_look_around": { "priority": 5 },
      "minecraft:tameable": {
        "probability": 1.0,
        "tame_items": ["minecraft:dirt"],
        "tame_event": { "event": "knws:tamed", "target": "self" }
      },
      "minecraft:pushable": { "is_pushable": false },
      "minecraft:conditional_bandwidth_optimization": {}
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": { "component_groups": ["knws:phase_nice", "knws:floating"] }
      },
      "knws:phase_0": { "add": { "component_groups": ["knws:phase_nice"] }, "remove": { "component_groups": ["knws:phase_zesty", "knws:phase_weird", "knws:phase_scary"] } },
      "knws:phase_1": { "add": { "component_groups": ["knws:phase_zesty"] }, "remove": { "component_groups": ["knws:phase_nice", "knws:phase_weird", "knws:phase_scary"] } },
      "knws:phase_2": { "add": { "component_groups": ["knws:phase_weird"] }, "remove": { "component_groups": ["knws:phase_nice", "knws:phase_zesty", "knws:phase_scary"] } },
      "knws:phase_3": { "add": { "component_groups": ["knws:phase_scary"] }, "remove": { "component_groups": ["knws:phase_nice", "knws:phase_zesty", "knws:phase_weird"] } },
      "knws:tamed": {}
    }
  }
}

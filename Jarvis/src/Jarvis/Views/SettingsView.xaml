<UserControl x:Class="Jarvis.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1200">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <Button Content="← Back to chat"
                    Style="{StaticResource GhostButtonStyle}"
                    DockPanel.Dock="Left"
                    Command="{Binding BackToChatCommand}" />
            <TextBlock Text="Settings"
                       Style="{StaticResource SectionHeaderStyle}"
                       HorizontalAlignment="Center"
                       Margin="0" />
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" HorizontalAlignment="Center">
                <Border Background="{StaticResource BrushBackgroundSecondary}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Voice"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushAccent}"
                                   Margin="0,0,0,12" />

                        <CheckBox Content="Enable voice input"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  IsChecked="{Binding VoiceInputEnabled}"
                                  Margin="0,0,0,10" />

                        <CheckBox Content="Enable voice output"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  IsChecked="{Binding VoiceOutputEnabled}"
                                  Margin="0,0,0,16" />

                        <TextBlock Text="Voice profile"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   Margin="0,0,0,6" />
                        <ComboBox Style="{StaticResource ModernComboBoxStyle}"
                                  ItemsSource="{Binding AvailableVoices}"
                                  SelectedItem="{Binding SelectedVoice}"
                                  Margin="0,0,0,16" />

                        <TextBlock Text="Speech rate"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   Margin="0,0,0,6" />
                        <Slider Style="{StaticResource ModernSliderStyle}"
                                Minimum="0.5"
                                Maximum="2.0"
                                TickFrequency="0.1"
                                IsSnapToTickEnabled="True"
                                Value="{Binding SpeechRate}" />
                        <TextBlock Text="{Binding SpeechRate, StringFormat=Rate: {0:0.0}x}"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="12"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource BrushBackgroundSecondary}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Memory &amp; History"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushAccent}"
                                   Margin="0,0,0,12" />

                        <CheckBox Content="Save conversation history"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  IsChecked="{Binding SaveConversationHistory}"
                                  Margin="0,0,0,10" />

                        <TextBlock Text="Maximum memory entries"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   Margin="0,8,0,6" />
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding MaxMemoryEntries, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Content="Clear local memory"
                                Style="{StaticResource AccentButtonStyle}"
                                Margin="0,16,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding ClearMemoryCommand}" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource BrushBackgroundSecondary}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="20">
                    <StackPanel>
                        <TextBlock Text="Diagnostics"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushAccent}"
                                   Margin="0,0,0,12" />
                        <TextBlock Text="Log directory"
                                   Foreground="{StaticResource BrushTextMuted}" />
                        <TextBlock Text="{Binding LogDirectory}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   FontFamily="Consolas" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,18,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{StaticResource BrushTextMuted}"
                       VerticalAlignment="Center"
                       DockPanel.Dock="Left" />
            <Button Content="Save settings"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Command="{Binding SaveSettingsCommand}" />
        </DockPanel>
    </Grid>
</UserControl>

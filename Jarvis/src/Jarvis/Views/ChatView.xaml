<UserControl x:Class="Jarvis.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:Jarvis.Models"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1200">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Conversation history sidebar -->
        <Border Grid.Column="0"
                Background="{StaticResource BrushBackgroundSecondary}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                    <Ellipse Width="12" Height="12" Fill="{StaticResource BrushAccent}" Margin="0,0,10,0" />
                    <TextBlock Text="JARVIS"
                               FontFamily="{StaticResource FontDisplay}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushAccent}" />
                </StackPanel>

                <Button Grid.Row="1"
                        Content="+ New chat"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,14"
                        Command="{Binding NewConversationCommand}" />

                <ListBox Grid.Row="2"
                         ItemsSource="{Binding Conversations}"
                         SelectedItem="{Binding SelectedConversation}"
                         BorderThickness="0"
                         Background="Transparent"
                         ItemContainerStyle="{StaticResource ConversationItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding UpdatedAt, StringFormat='Updated {0:g}'}"
                                           FontSize="11"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Row="3"
                        Content="Settings"
                        Style="{StaticResource GhostButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Margin="0,12,0,0"
                        Command="{Binding OpenSettingsCommand}" />
            </Grid>
        </Border>

        <!-- Chat area -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#121E33"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16,12"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Assistant Console"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Futuristic local AI workspace"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="12"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#6BFF8A" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Online"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{StaticResource BrushBackgroundSecondary}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16"
                    Margin="0,0,0,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ChatMessage}">
                                <Border Margin="0,0,0,12"
                                        MaxWidth="760"
                                        Padding="14,12"
                                        CornerRadius="14"
                                        HorizontalAlignment="{Binding Role, Converter={StaticResource MessageRoleToAlignmentConverter}}"
                                        Background="{Binding Role, Converter={StaticResource MessageRoleToBrushConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Role}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushAccentDim}"
                                                   Margin="0,0,0,6" />
                                        <TextBlock Text="{Binding Content}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="22" />
                                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource BrushTextMuted}"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Input bar -->
            <Border Grid.Row="2"
                    Background="#121E33"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Width="46"
                            Height="46"
                            Margin="0,0,10,0"
                            Command="{Binding ToggleVoiceInputCommand}"
                            ToolTip="Voice input">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Root"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="23">
                                                <TextBlock Text="🎤"
                                                           FontSize="18"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsListening}" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="#12384A" />
                                                    <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BrushAccentDim}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <TextBox Grid.Column="1"
                             Style="{StaticResource ModernTextBoxStyle}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="46"
                             MaxHeight="140"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter"
                                        Modifiers="Control"
                                        Command="{Binding SendMessageCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <Button Grid.Column="2"
                            Content="Send"
                            Style="{StaticResource AccentButtonStyle}"
                            Margin="10,0,0,0"
                            MinWidth="88"
                            Command="{Binding SendMessageCommand}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

<Window x:Class="Jarvis.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jarvis"
        Width="1280"
        Height="820"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.15" GradientOrigin="0.5,0.15" RadiusX="0.9" RadiusY="0.9">
                <GradientStop Color="#2200EAFF" Offset="0" />
                <GradientStop Color="#00050810" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>

        <Border Margin="16"
                Background="#CC0A1424"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="18">
            <ContentControl Content="{Binding CurrentViewModel}" />
        </Border>
    </Grid>
</Window>

{
  "name": "jarvis",
  "version": "1.0.0",
  "description": "Jarvis — Personal voice assistant with orb interface",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build:linux": "electron-builder --linux AppImage"
  },
  "author": "X-MAN-Ascension",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.jarvis.assistant",
    "productName": "Jarvis",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "shared/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
